<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Identifikation des Maven-Projekts -->
    <groupId>com.gamingtracker</groupId>
    <artifactId>gaming-tracker</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>

        <!-- Das Projekt verwendet Java 21 -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!-- Einheitliche Zeichenkodierung für das Projekt -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Version von JavaFX -->
        <javafx.version>21.0.8</javafx.version>
    </properties>

    <dependencies>

        <!-- JavaFX Controls: Buttons, Textfelder, Labels, ComboBoxen usw. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX FXML für deklarative Benutzeroberflächen -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Jackson übernimmt die Umwandlung zwischen Java-Objekten und JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.20.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Konfiguration des Java-Compilers -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!-- Ermöglicht das Starten der JavaFX-Anwendung über Maven -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>

                    <!-- Einstiegspunkt der Anwendung -->
                    <mainClass>com.gamingtracker.App</mainClass>

                </configuration>
            </plugin>

        </plugins>
    </build>

</project>